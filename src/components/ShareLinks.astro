---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

export interface Props {
  title?: string;
  compact?: boolean;
}

const { title, compact = false } = Astro.props;
const URL = Astro.url;
---

{
  SHARE_LINKS.length > 0 && (
    <div class:list={[
      "flex items-center gap-1",
      { "flex-col md:items-start": !compact }
    ]}>
      {!compact && <span class="italic">Share this post on:</span>}
      <div class="flex items-center">
        {SHARE_LINKS.map(social => {
          // Build share URL with title for X
          let shareUrl = social.href + URL;
          if (social.name === "X" && title) {
            shareUrl = `${social.href}${URL}&text=${encodeURIComponent(title)}`;
          }

          const iconClass = social.iconStyle === "outline"
            ? `fill-transparent stroke-current stroke-2 opacity-70 hover:opacity-100 ${compact ? "size-5" : "size-6"}`
            : `fill-current opacity-70 hover:opacity-100 ${compact ? "size-5" : "size-6"}`;

          return (
            <LinkButton
              href={shareUrl}
              class="p-1"
              title={social.linkTitle}
            >
              <social.icon class={iconClass} />
              <span class="sr-only">{social.linkTitle}</span>
            </LinkButton>
          );
        })}
      </div>
    </div>
  )
}
