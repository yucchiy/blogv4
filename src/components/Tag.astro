---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  count?: number;
}

const { tag, tagName, size = "sm", count } = Astro.props;
---

<li class="inline">
  <a
    href={`/tags/${tag}`}
    transition:name={tag}
    class:list={[
      "rounded bg-accent/10 px-2 py-1 text-foreground/80 hover:bg-accent/20 hover:text-accent",
      { "text-sm px-1.5 py-0.5": size === "sm" },
    ]}
  >
    {tagName}{count != null && <span class="ml-1 opacity-60">({count})</span>}
  </a>
</li>
